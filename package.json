    "@capacitor/preferences": "^7.0.2",
    "@capacitor/status-bar": "7.0.2",
    "@formkit/tempo": "^0.1.2",
    "@hookform/resolvers": "^5.2.2",
    "@ionic/react": "^8.5.0",
    "@ionic/react-router": "^8.5.0",
    "@radix-ui/react-slot": "^1.2.3",
